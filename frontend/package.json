{
  "name": "media-operations-console",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build --configLoader runner",
    "format": "prettier --write \"src/**/*.{vue,css}\" index.html",
    "format:check": "prettier --check \"src/**/*.{vue,css}\" index.html",
    "lint": "eslint \"src/**/*.vue\" && stylelint \"src/**/*.css\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/vue": "1.30.0",
    "@vitejs/plugin-vue": "6.0.8",
    "pinia": "4.0.2",
    "vite": "8.2.1",
    "vue": "3.5.41",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.74.0",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "prettier": "^3.10.1",
    "stylelint": "^16.26.1",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.9"
  }
}
